# 环境变量示例文件。
# 本项目的主配置是 config.yml（复制 config.example.yml 得到），此处仅收录
# 代码中真实支持的环境变量覆盖项。使用方法（任选其一）：
#   - 命令行：export OPENAI_API_KEY="sk-..." 后运行 python run.py
#   - Docker：docker run --env-file .env ...
# 注意：本项目不自动加载 .env 文件，需要自行导出这些变量。

# OpenAI Transcriptions API Key（视频转写功能，对应 transcript.api_key_env 默认值）
OPENAI_API_KEY=

# yt-dlp 引擎（爱奇艺 / 腾讯视频 / 优酷等平台）的 Netscape 格式 cookies.txt 路径
YTDLP_COOKIE_FILE=

# 配置覆盖（优先级高于 config.yml，对应 config/config_loader.py）
DOUYIN_COOKIE=
DOUYIN_PATH=
DOUYIN_THREAD=
DOUYIN_PROXY=
